# Log all execve calls (commands run)
-a always,exit -F arch=b64 -S execve -k exec

# Track sudoers changes
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d -p wa -k sudoers

# Track cron/at changes
-w /etc/cron.d -p wa -k cron
-w /etc/cron.daily -p wa -k cron
-w /etc/cron.hourly -p wa -k cron
-w /etc/cron.weekly -p wa -k cron
-w /etc/cron.monthly -p wa -k cron
-w /var/spool/cron -p wa -k cron

# Track new binaries under /usr/local and /opt
-w /usr/local/bin -p wa -k newbin
-w /opt -p wa -k newbin

# Track file deletions and renames (data manipulation)
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat,truncate,ftruncate -k data_delete

# Track writes to /home and /tmp (common Red team staging areas)
-w /tmp -p wax -k staging
-w /home/ubuntu -p wax -k staging

# Track OpSim telemetry data directory
-w /home/ubuntu/control/telemetry -p wax -k opsim_data
-w /home/ubuntu/control_interface/exercise.db -p wa -k queue_manipulation